{
  "params": {
    "placementId": {
      "description": "The ability slot. Use a friendly name. Also accepts the alias names and slot numbers.",
      "values": ["primary", "q", "e", "dash", "r", "c", "t"]
    },
    "weaponCategory": {
      "description": "Weapon category. Case-insensitive. Defaults to your equipped weapon.",
      "values": ["Unarmed", "Axe", "Claws", "Crossbow", "Daggers", "FishingPole", "GreatSword", "Longbow", "Mace", "Pistols", "Reaper", "Slashers", "Spear", "Sword", "TwinBlades", "Whip", "All"]
    },
    "color": {
      "description": "A Unity rich text color name or a hex code like #FF8800.",
      "values": ["white", "red", "orange", "yellow", "green", "blue", "cyan", "purple", "magenta", "black", "grey"]
    },
    "fontSize": {
      "description": "Font size for the sign text. Defaults to 18."
    },
    "idOrText": {
      "description": "A sign id (number), or a piece of sign text to match."
    }
  },
  "commands": {
    "customabilities:abilities:set": {
      "params": {
        "prefabGuid": { "description": "Ability prefab GUID (integer)." }
      }
    },
    "customabilities:abilities:cast": {
      "params": {
        "prefabGuid": { "description": "Ability prefab GUID (integer)." }
      }
    },
    "customabilities:abilities:item set": {
      "params": {
        "prefabGUID": { "description": "Ability prefab GUID (integer)." }
      }
    },
    "customabilities:abilities:spell assign": {
      "params": {
        "spellIdentifier": { "description": "Spell GUID, name, alias, or a fuzzy match." }
      }
    },
    "keys:keys:list": {
      "params": {
        "target": {
          "description": "What to list. Use mine, clan, all, or a clan name. The all option and a clan name require admin.",
          "values": ["mine", "clan", "all"]
        }
      }
    },
    "keys:keys:remove": {
      "params": {
        "target": {
          "description": "Use clan to remove your clan's keys, or a player name to remove one player's key."
        }
      }
    },
    "keys:keys:give": {
      "params": {
        "bypassKeyword": {
          "description": "Type bypass to skip ownership checks.",
          "values": ["bypass"]
        }
      }
    },
    "keys:keys:giveall": {
      "params": {
        "bypassKeyword": {
          "description": "Type bypass to skip ownership checks.",
          "values": ["bypass"]
        }
      }
    },
    "keys:keys:giveradius": {
      "params": {
        "radius": {
          "description": "Radius in world units. Defaults to 10."
        },
        "bypassKeyword": {
          "description": "Type bypass to skip ownership checks.",
          "values": ["bypass"]
        }
      }
    },
    "sovutilities:sov:onboardrace": {
      "description": "Onboard your character as a specific race. This is a one-time setup.",
      "examples": [".sov onboardrace human warrior brighthaven"],
      "params": {
        "race": {
          "description": "The race to onboard as. Each race takes different extra arguments.",
          "values": ["human", "vampire", "werewolf", "mytt", "talam"]
        },
        "arg1": {
          "description": "First race option. For human this is the blood type. For mytt this is school 1. For talam this is the subrace."
        },
        "arg2": {
          "description": "Second race option. For human this is the optional faction. For mytt this is school 2. For talam this is the blood type."
        },
        "arg3": {
          "description": "Third race option. For mytt this is school 3. For talam this is the optional faction."
        },
        "arg4": {
          "description": "Fourth race option. For mytt this is the faction."
        }
      }
    },
